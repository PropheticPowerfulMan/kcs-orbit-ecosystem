{
  "name": "KCS Kitchen",
  "short_name": "Kitchen",
  "id": "/kitchen/",
  "start_url": "/kitchen/",
  "scope": "/kitchen/",
  "lang": "fr",
  "description": "Gestion professionnelle de la cantine de Kinshasa Christian School",
  "categories": ["education", "business", "food"],
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#edf6fb",
  "theme_color": "#06365f",
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "shortcuts": [
    { "name": "Point de vente", "short_name": "POS", "url": "/kitchen/?page=pos", "icons": [{ "src": "/kitchen/icons/kitchen-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Catalogue", "short_name": "Catalogue", "url": "/kitchen/?page=catalog", "icons": [{ "src": "/kitchen/icons/kitchen-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "icons": [
    { "src": "/kitchen/icons/kitchen-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/kitchen/icons/kitchen-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/kitchen/icons/kitchen-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
