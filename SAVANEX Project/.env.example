# ═══════════════════════════════════════════════════════════════
# SAVANEX School Management System — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── Django ────────────────────────────────────────────────────
SECRET_KEY=your-very-secret-django-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Initial production administrator (required on first deployment)
# The bootstrap command never overwrites the password of an existing account.
SAVANEX_ADMIN_USERNAME=
SAVANEX_ADMIN_EMAIL=
SAVANEX_ADMIN_PASSWORD=

# ─── Database ──────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=savanex_db
DB_USER=savanex_user
DB_PASSWORD=savanex_pass
DB_HOST=db
DB_PORT=5432

# ─── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── CORS ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Email ─────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.kinshasachristianschool.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=notifications@kinshasachristianschool.org
EMAIL_HOST_PASSWORD=CHANGE_ME_LWS_MAILBOX_PASSWORD
DEFAULT_FROM_EMAIL="Kinshasa Christian School <notifications@kinshasachristianschool.org>"
SCHOOL_NAME=SAVANEX School

# Parent SMS delivery
# Option A: generic SMS gateway webhook receiving {"to": "...", "message": "..."}
SMS_ENABLED=True
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Option B: Twilio fallback when no webhook is configured
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
INTELLIGENCE_INGEST_API_KEY=change-this-shared-secret

# ─── Media & Static ────────────────────────────────────────────
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# ─── Frontend ──────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=SAVANEX SMS
