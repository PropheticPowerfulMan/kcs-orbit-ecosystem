FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_BASE_PATH=/lesson-plan/
ARG VITE_PUBLIC_APP_URL=https://kinshasachristianschool.org/lesson-plan/
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_FEDERATED_AUTH_URL=/lesson-plan/api/auth/ecosystem-login
ENV VITE_BASE_PATH=$VITE_BASE_PATH
ENV VITE_PUBLIC_APP_URL=$VITE_PUBLIC_APP_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_FEDERATED_AUTH_URL=$VITE_FEDERATED_AUTH_URL
RUN npm run build:vps

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
