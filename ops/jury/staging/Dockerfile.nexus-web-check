FROM node:20-alpine AS build
WORKDIR /app
COPY ["KCS Nexus/frontend/package.json", "KCS Nexus/frontend/package-lock.json", "./"]
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY ["KCS Nexus/frontend", "./"]
ENV VITE_API_URL=/jury-nexus/api VITE_BASE_PATH=/jury-nexus/ VITE_JURY_ENABLED=true VITE_JURY_PUBLIC_URL=https://staging.kinshasachristianschool.org/jury/
RUN npm run build
FROM nginx:1.27-alpine
COPY ["ops/jury/staging/nexus-preview.nginx.conf", "/etc/nginx/conf.d/default.conf"]
COPY --from=build /app/dist /usr/share/nginx/html
