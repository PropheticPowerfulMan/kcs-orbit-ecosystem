(security_headers) {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
    X-Permitted-Cross-Domain-Policies "none"
    Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; media-src 'self' blob:; frame-src 'self' https://www.google.com https://maps.google.com"
  }
}
{$ORBIT_API_DOMAIN} {
  import security_headers
  reverse_proxy orbit_api:4500
}

{$NEXUS_API_DOMAIN} {
  import security_headers
  reverse_proxy nexus_api:5000
}
{$NEXUS_DOMAIN} {
  import security_headers

  # School-owned media admission: no token in referrers or public management ports.
  @kcs_classroom path /remote-rtc /remote-rtc/*
  handle @kcs_classroom {
    uri strip_prefix /remote-rtc
    forward_auth nexus_api:5000 {
      uri /api/learning/media-authorize
      header_up X-KCS-Classroom-Token {query.access_token}
    }
    reverse_proxy {$KCS_CLASSROOM_UPSTREAM:172.19.0.1:7880}
  }

  redir /jury /jury/ 308
  handle_path /jury/api/* {
    rewrite * /api/jury{path}
    reverse_proxy nexus_api:5000
  }
  handle_path /jury/* {
    reverse_proxy jury_web:8080
  }
  redir /kitchen /kitchen/ 308
  handle /kitchen/api/health {
    rewrite * /health
    reverse_proxy kitchen_api:5100
  }
  handle /kitchen/api/* {
    uri strip_prefix /kitchen
    reverse_proxy kitchen_api:5100
  }
  handle_path /kitchen/* {
    reverse_proxy kitchen_web:80
  }
  redir /sentinel /sentinel/ 308
  handle /sentinel/api/* {
    uri strip_prefix /sentinel
    reverse_proxy sentinel_api:4000
  }
  handle_path /sentinel/* {
    reverse_proxy sentinel_web:80
  }
  redir /lesson-plan /lesson-plan/ 308
  # Only expiring, authenticated-generated PDFs may be embedded by the school origin.
  handle /lesson-plan/api/documents/view/* {
    header >X-Frame-Options SAMEORIGIN
    header >Content-Security-Policy "default-src 'none'; frame-ancestors 'self'"
    header >Referrer-Policy no-referrer
    uri strip_prefix /lesson-plan
    reverse_proxy lessonplan_api:3001
  }
  handle /lesson-plan/api/* {
    uri strip_prefix /lesson-plan
    reverse_proxy lessonplan_api:3001
  }
  handle_path /lesson-plan/* {
    reverse_proxy lessonplan_web:80
  }
  handle {
    # Only Nexus pages embed the approved video players; other apps retain their policy.
    header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; media-src 'self' blob: https:; frame-src 'self' https://www.google.com https://maps.google.com https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com"
    header Referrer-Policy "strict-origin-when-cross-origin"
    reverse_proxy nexus_web:80
  }
}

www.{$NEXUS_DOMAIN} {
  import security_headers
  redir https://{$NEXUS_DOMAIN}{uri} permanent
}


{$ACADEMY_DOMAIN} {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
    X-Permitted-Cross-Domain-Policies "none"
    Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; media-src 'self' blob:; frame-src 'self' https://www.google.com https://maps.google.com"
  }
  reverse_proxy academy:3000
}

{$EDUPAY_DOMAIN} {
  import security_headers
  # Compatibility route for older installed PWA bundles that still send
  # institutional login requests to the public Web origin.
  handle /api/* {
    reverse_proxy edupay_api:4000
  }
  handle {
    reverse_proxy edupay_web:80
  }
}

{$EDUPAY_API_DOMAIN} {
  import security_headers
  reverse_proxy edupay_api:4000
}

