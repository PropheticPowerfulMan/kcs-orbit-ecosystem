  reverse_proxy savanex_web:80
}

{$SAVANEX_API_DOMAIN} {
  import security_headers
  reverse_proxy savanex_api:8000
}

{$EDUSYNC_DOMAIN} {
  import security_headers
  reverse_proxy edusync_web:80
}

{$EDUSYNC_API_DOMAIN} {
  import security_headers
  reverse_proxy edusync_api:8000
}

{$STAGING_DOMAIN} {
  import security_headers
  header {
    X-Robots-Tag "noindex, nofollow, noarchive"
    Cache-Control "no-store"
  }
  reverse_proxy staging_gateway:8080
}
