:8080 {
  header {
    X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    Cache-Control "no-store"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
    Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' https://www.google.com https://maps.google.com"
  }

  handle /healthz {
    respond "staging gateway healthy" 200
  }

  handle /api/health {
    rewrite * /health
    reverse_proxy edupay_api:4000
  }

  handle /api/* {
    reverse_proxy edupay_api:4000
  }

  redir /nexus /nexus/ 308
  handle /nexus/api/health {
    rewrite * /health
    reverse_proxy nexus_api:5000
  }
  handle /nexus/api/* {
    uri strip_prefix /nexus
    reverse_proxy nexus_api:5000
  }
  handle_path /nexus/* {
    reverse_proxy nexus_web:80
  }

  redir /savanex /savanex/ 308
  handle /savanex/api/* {
    uri strip_prefix /savanex
    reverse_proxy savanex_api:8000
  }
  handle_path /savanex/* {
    reverse_proxy savanex_web:80
  }

  handle {
    reverse_proxy edupay_web:80
  }
}
