BACKUP_ROOT=/var/backups/kcs-ecosystem
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=28
BACKUP_RETENTION_MONTHS=365

# Keep real connection strings only in /etc/kcs-ecosystem/backup.env (chmod 600).
ORBIT_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/kcs_orbit
NEXUS_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/kcs_nexus
EDUPAY_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/edupay
SAVANEX_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/savanex

# Optional transition databases and user files (space-separated absolute paths).
SQLITE_DATABASES=/srv/kcs-ecosystem/edusync/backend/edusync.db
PERSISTENT_PATHS=/srv/kcs-ecosystem/kcs-nexus/backend/uploads /srv/kcs-ecosystem/savanex/backend/media

# Optional encryption (age public recipient) and off-site rclone destination.
BACKUP_AGE_RECIPIENT=
BACKUP_RCLONE_DESTINATION=
