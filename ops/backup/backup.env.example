BACKUP_ROOT=/var/backups/kcs-ecosystem
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=28
BACKUP_RETENTION_MONTHS=365

# Production databases are private Docker services. Back them up through their
# containers so port 5432 never needs to be published on the VPS.
ORBIT_DATABASE_CONTAINER=kcs-orbit-orbit-db
NEXUS_DATABASE_CONTAINER=kcs-orbit-nexus-db
EDUPAY_DATABASE_CONTAINER=kcs-orbit-edupay-db
SAVANEX_DATABASE_CONTAINER=kcs-orbit-savanex-db
EDUSYNC_DATABASE_CONTAINER=kcs-orbit-edusync-db

# Optional URL mode for a separately managed PostgreSQL server.
ORBIT_DATABASE_URL=
NEXUS_DATABASE_URL=
EDUPAY_DATABASE_URL=
SAVANEX_DATABASE_URL=
EDUSYNC_DATABASE_URL=

# Optional development/transition databases. Leave empty in PostgreSQL production.
SQLITE_DATABASES=

# Docker named-volume data containing user-generated files (space-separated).
PERSISTENT_PATHS=/var/lib/docker/volumes/kcs-orbit-production_nexus_uploads/_data /var/lib/docker/volumes/kcs-orbit-production_edupay_receipts/_data /var/lib/docker/volumes/kcs-orbit-production_savanex_media/_data

# Optional encryption (age public recipient) and off-site rclone destination.
BACKUP_AGE_RECIPIENT=
BACKUP_RCLONE_DESTINATION=
