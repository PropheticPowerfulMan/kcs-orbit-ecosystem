NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
FRONTEND_URL=https://your-frontend-domain.com
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret

# KCS admissions/contact recipient
SCHOOL_EMAIL=kinshasachristianschool@gmail.com

# SMTP sender account. For Gmail, use an app password, not the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="KCS Nexus Admissions <your-sender@gmail.com>"

# Shared authentication bridge to EduPay
EDUPAY_API_URL=http://localhost:4000
# JWT for an EduPay ADMIN or ACCOUNTANT service account. Keep this server-side only.
EDUPAY_SERVICE_TOKEN=replace-with-edupay-admin-or-accountant-jwt
EDUPAY_SERVICE_EMAIL=admin@school.com
EDUPAY_SERVICE_PASSWORD=change-this-password
EDUPAY_LOGIN_PATH=/api/auth/login
EDUPAY_TIMEOUT_SECONDS=15

# Cross-app intelligence bridge to SAVANEX
SAVANEX_API_URL=http://localhost:8001
SAVANEX_LOGIN_PATH=/api/auth/login/
SAVANEX_TIMEOUT_SECONDS=15
SAVANEX_INTELLIGENCE_API_KEY=change-this-shared-secret
