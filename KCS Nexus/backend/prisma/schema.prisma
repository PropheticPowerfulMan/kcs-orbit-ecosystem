generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([usedAt])
  @@index([userId, expiresAt])
}

enum ImportJobStatus {
  UPLOADED
  MAPPED
  VALIDATED
  READY
  IMPORTING
  COMPLETED
  PARTIAL
  FAILED
  ROLLED_BACK
  ROLLBACK_PARTIAL
  ROLLBACK_BLOCKED
}

model ImportJob {
  id               String          @id @default(cuid())
  actorId          String
  organizationId   String?
  sourceSystem     String          @default("GENERIC")
  entityType       String
  originalFileName String
  fileHash         String
  status           ImportJobStatus @default(UPLOADED)
  mapping          Json?
  report           Json?
  totalRows        Int             @default(0)
  createdRows      Int             @default(0)
  updatedRows      Int             @default(0)
  skippedRows      Int             @default(0)
  failedRows       Int             @default(0)
  mergedRows       Int             @default(0)
  invitationsSent  Boolean         @default(false)
  confirmedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([actorId, createdAt])
  @@index([organizationId, createdAt])
  @@index([status])
}

model ImportMappingTemplate {
  id             String   @id @default(cuid())
  name           String
  actorId        String
  organizationId String?
  sourceSystem   String   @default("GENERIC")
  entityType     String
  sourceColumns  String[]
  mapping        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, name, entityType])
  @@index([organizationId, entityType])
}

model ImportChange {
  id            String    @id @default(cuid())
  importJobId   String
  entityType    String
  entityId      String
  operation     String
  oldValue      Json?
  newValue      Json?
  changedAt     DateTime  @default(now())
  rolledBackAt  DateTime?
  rollbackError String?

  @@index([importJobId, changedAt])
  @@index([entityType, entityId])
}

enum UserRole {
  ADMIN
  STAFF
  TEACHER
  STUDENT
  PARENT
}

enum NewsCategory {
  NEWS
  EVENT
  ANNOUNCEMENT
  ACHIEVEMENT
  SPORTS
  ARTS
}

enum EventType {
  ACADEMIC
  SPIRITUAL
  SPORTS
  CULTURAL
  ADMINISTRATIVE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  ACCEPTED
  WAITLISTED
  REJECTED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  MESSAGE
}

enum AssignmentType {
  HOMEWORK
  CLASSWORK
  QUIZ
  TEST
  EXAM
  PROJECT
  LAB
  PRESENTATION
  RESEARCH
  PRACTICAL
}

enum AssignmentCadence {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  TERM
  ANNUAL
}

enum TeacherReportStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  RETURNED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  SICK
  SUSPENDED
}

enum FeeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
}

enum DiagnosticSubject {
  FRENCH
  MATHEMATICS
}

enum DiagnosticTestStatus {
  DRAFT
  PUBLISHED
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  AUTO_GRADED
  PENDING_SUPER_ADMIN_APPROVAL
  APPROVED
  REJECTED
  RETAKE_REQUESTED
  ARCHIVED
}

enum DiagnosticQuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  NUMERIC
  ESSAY_OPTIONAL
}

enum DiagnosticDifficulty {
  EASY
  MEDIUM
  HARD
}

enum DiagnosticDecision {
  ACCEPT_REQUESTED_GRADE
  ACCEPT_WITH_REMEDIATION
  RECOMMEND_LOWER_LEVEL
  RETAKE_TEST
  ACADEMIC_INTERVIEW_REQUIRED
  REJECT
}

enum TeacherStatus {
  HOMEROOM_TEACHER
  TEACHER
  ASSISTANT_TEACHER
}

enum AdmissionInquiryStatus {
  NEW
  CONTACTED
  TOUR_SCHEDULED
  APPLICATION_INVITED
  CLOSED
}

enum FeeChargeKind {
  STANDARD_FEE
  DISCOUNT
  SCHOLARSHIP
  FAMILY_PAYMENT
  ADJUSTMENT
}

enum ReportPublicationStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  EMAILED
  POSTED_TO_PORTAL
}

enum CorrespondenceChannel {
  EMAIL
  TEXT
  LETTER
  CALL
  PORTAL
}

enum CorrespondenceStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  FAILED
  LOGGED
}

enum DisciplineSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DisciplineResolutionStatus {
  OPEN
  INVESTIGATING
  PARENT_CONTACTED
  RESOLVED
  ESCALATED
}

model User {
  remoteLessons RemoteLesson[] @relation("RemoteLessonOwner")
  remoteConnections RemoteConnection[]
  assignmentDrafts AssignmentDraft[]

  id                             String                   @id @default(cuid())
  email                          String                   @unique
  accessCode                     String                   @unique
  passwordHash                   String?
  firstName                      String
  middleName                     String?
  lastName                       String
  role                           UserRole
  staffFunction                  String?
  permissions                    String[]                 @default([])
  avatar                         String?
  signatureImage                 String?
  signatureUpdatedAt             DateTime?
  officialSealImage              String?
  officialSealUpdatedAt          DateTime?
  phone                          String?
  googleId                       String?                  @unique
  orbitUserId                    String?                  @unique
  orbitOrganizationId            String?
  accountBlockedAt               DateTime?
  accountBlockedReason           String?
  accountBlockedBy               String?
  failedLoginAttempts            Int                      @default(0)
  loginLockedUntil               DateTime?
  lastFailedLoginAt              DateTime?
  lastLoginAt                    DateTime?
  passwordChangedAt              DateTime?
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  studentProfile                 StudentProfile?
  teacherProfile                 TeacherProfile?
  parentLinks                    ParentStudentLink[]      @relation("ParentLinks")
  notifications                  Notification[]
  authoredNews                   NewsPost[]               @relation("NewsAuthor")
  contactMessages                ContactMessage[]
  refreshTokens                  RefreshToken[]
  applicationCredentials         ApplicationCredential[]
  passwordResetTokens            PasswordResetToken[]
  forumPosts                     ParentForumPost[]        @relation("ForumPostAuthor")
  forumComments                  ParentForumComment[]     @relation("ForumCommentAuthor")
  aiForumReports                 AIForumReport[]          @relation("AIForumReportReviewer")
  studentForumPosts              StudentForumPost[]       @relation("StudentForumPostAuthor")
  studentForumComments           StudentForumComment[]    @relation("StudentForumCommentAuthor")
  studentForumLikes              StudentForumLike[]       @relation("StudentForumLikeUser")
  aiStudentForumReports          AIStudentForumReport[]   @relation("AIStudentForumReportReviewer")
  auditLogs                      AuditLog[]               @relation("AuditActor")
  staffProfile                   StaffProfile?
  attendanceRecorded             AttendanceRecord[]       @relation("AttendanceRecorder")
  staffAttendanceRecorded        StaffAttendanceRecord[]  @relation("StaffAttendanceRecorder")
  sentMessages                   InternalMessage[]        @relation("MessageSender")
  receivedMessages               InternalMessage[]        @relation("MessageRecipient")
  approvedReportCards            ReportCard[]             @relation("ReportCardApprover")
  teacherWorkspace               TeacherWorkspace?
  suggestions                    Suggestion[]             @relation("SuggestionAuthor")
  diagnosticTestsCreated         DiagnosticTest[]         @relation("DiagnosticTestCreator")
  diagnosticApprovals            DiagnosticApproval[]     @relation("DiagnosticApprovalActor")
  teacherReviewsGiven            TeacherReview[]          @relation("TeacherReviewReviewer")
  correspondenceSent             CorrespondenceLog[]      @relation("CorrespondenceSender")
  disciplineReported             DisciplineCase[]         @relation("DisciplineReporter")
  disciplineResolved             DisciplineCase[]         @relation("DisciplineResolver")
  twoFactorEnabled               Boolean                  @default(false)
  twoFactorSecret                String?
  twoFactorVerifiedAt            DateTime?
  electiveCyclesCreated          ElectiveCycle[]          @relation("ElectiveCycleCreator")
  electiveOfferingsTaught        ElectiveOffering[]       @relation("ElectiveOfferingTeacher")
  electiveOfferingsProposed      ElectiveOffering[]       @relation("ElectiveOfferingProposer")
  classroomPassesSupervised ClassroomPassSession[] @relation("ClassroomPassTeacher")
  shiningStudentSchedulesCreated ShiningStudentSchedule[] @relation("ShiningStudentScheduleCreator")
  eventReminderDeliveries        EventReminderDelivery[]
  juryProject_owner JuryProject[] @relation("JuryProject_owner")
  juryMember_user JuryMember[] @relation("JuryMember_user")
  juryRubricTemplate_owner JuryRubricTemplate[] @relation("JuryRubricTemplate_owner")
  juryAppSession_user JuryAppSession[] @relation("JuryAppSession_user")
  juryLaunchTicket_user JuryLaunchTicket[] @relation("JuryLaunchTicket_user")
  juryDraftKey_user JuryDraftKey[] @relation("JuryDraftKey_user")
  juryRoleGrant_user JuryRoleGrant[] @relation("JuryRoleGrant_user")
  valueWordAssignments ValueWordAssignment[]

}

model TeacherWorkspace {
  id        String   @id @default(cuid())
  userId    String   @unique
  state     Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Suggestion {
  id            String   @id @default(cuid())
  authorId      String
  anonymousRole UserRole
  category      String
  message       String
  status        String   @default("New")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  author        User     @relation("SuggestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([status])
}

model StaffProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  employeeNumber String   @unique
  function       String
  department     String
  permissions    String[] @default([])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentProfile {
  id                      String                   @id @default(cuid())
  userId                  String                   @unique
  studentNumber           String                   @unique
  grade                   String
  section                 String
  dateOfBirth             DateTime?
  enrollmentDate          DateTime                 @default(now())
  status                  String                   @default("active")
  transcriptVisible       Boolean                  @default(false)
  /// Official registry portrait managed by authorized school staff.
  /// The student's self-service dashboard avatar remains on User.avatar.
  officialAvatar          String?
  gpa                     Float?
  attendanceRate          Float?
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentLinks             ParentStudentLink[]      @relation("StudentLinks")
  enrollments             Enrollment[]
  grades                  Grade[]
  submissions             AssignmentSubmission[]
  aiSessions              AITutorSession[]
  aiRecommendations       AIRecommendation[]
  attendanceRecords       AttendanceRecord[]
  legacyTranscriptRecords LegacyTranscriptRecord[]
  reportCards             ReportCard[]
  transcripts             Transcript[]
  feeInvoices             FeeInvoice[]
  diagnosticAssignments   DiagnosticAssignment[]
  diagnosticSubmissions   DiagnosticSubmission[]
  disciplineCases         DisciplineCase[]
  electiveChoices         ElectiveChoice[]
  electiveAllocations     ElectiveAllocation[]
  classroomPasses ClassroomPassSession[]
  shiningStudentSchedules ShiningStudentSchedule[]
  archive                 StudentArchive?
  coursePresences StudentCoursePresence[]
  juryParticipant_student JuryParticipant[] @relation("JuryParticipant_student")
}

/// Immutable administrative snapshot created when a learner is permanently
/// dismissed. Academic records remain in their original tables while the
/// active identity is blocked and removed from operational rosters.
model StudentArchive {
  id               String   @id @default(cuid())
  studentId        String   @unique
  userId           String
  studentNumber    String
  orbitUserId      String?
  fullName         String
  grade            String
  section          String
  reason           String
  effectiveDate    DateTime
  archivedSnapshot Json
  archivedById     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([effectiveDate])
  @@index([studentNumber])
  @@index([archivedById])
}

enum ShiningStudentDivision {
  LOWER
  MIDDLE_UPPER
}

enum ShiningStudentStatus {
  SCHEDULED
  TOPIC_SUBMITTED
  PRESENTED
  EXCUSED
}

model ShiningStudentSchedule {
  id          String                 @id @default(cuid())
  date        DateTime
  division    ShiningStudentDivision
  studentId   String
  topic       String?
  topicNotes  String?
  status      ShiningStudentStatus   @default(SCHEDULED)
  notifiedAt  DateTime?
  createdById String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  student     StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation("ShiningStudentScheduleCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([date, division])
  @@index([studentId, date])
  @@index([date, status])
}

model ParentStudentLink {
  id        String         @id @default(cuid())
  parentId  String
  studentId String
  relation  String
  parent    User           @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model TeacherProfile {
  id                String                  @id @default(cuid())
  userId            String                  @unique
  employeeNumber    String                  @unique
  department        String
  qualification     String
  yearsOfExperience Int
  bio               String?
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses           Course[]
  status            TeacherStatus           @default(TEACHER)
  homeroomGrade     String?
  homeroomSection   String?
  diagnosticTests   DiagnosticTest[]
  reviews           TeacherReview[]
  teachingSessions  TeachingSession[]
  activityReports   TeacherActivityReport[]
}

model Course {
  remoteLessons RemoteLesson[]
  assignmentDrafts AssignmentDraft[]

  id          String           @id @default(cuid())
  name        String
  code        String           @unique
  description String
  grade       String
  teacherId   String
  credits     Int              @default(1)
  syllabus    String?
  teacher     TeacherProfile   @relation(fields: [teacherId], references: [id])
  teachingSessions TeachingSession[]
  schedules   CourseSchedule[]
  assignments Assignment[]
  grades      Grade[]
  enrollments Enrollment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  juryProjectCourse_course JuryProjectCourse[] @relation("JuryProjectCourse_course")
  juryGradebookLink_course JuryGradebookLink[] @relation("JuryGradebookLink_course")
  juryPublication_course JuryPublication[] @relation("JuryPublication_course")
}

model AcademicScheduleEntry {
  id             String   @id @default(cuid())
  sourceKey      String   @unique
  academicYear   String
  semester       Int
  grade          String
  classGroup     String?
  day            String
  period         Int
  startTime      String
  endTime        String
  subject        String
  teacherName    String?
  room           String?
  sourceDocument String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([academicYear, semester, grade, day])
  @@index([teacherName, day])
}

model CourseSchedule {
  id        String @id @default(cuid())
  courseId  String
  day       String
  startTime String
  endTime   String
  room      String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String         @id @default(cuid())
  courseId  String
  studentId String
  createdAt DateTime       @default(now())
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
}

model Assignment {
  publicationKey String? @unique
  id                 String                 @id @default(cuid())
  courseId           String
  title              String
  description        String
  dueDate            DateTime
  maxScore           Float
  type               AssignmentType
  cadence            AssignmentCadence      @default(ONE_TIME)
  estimatedMinutes   Int?
  resourceUrl        String?
  resourceName       String?
  isInteractive      Boolean                @default(false)
  aiGenerated        Boolean                @default(false)
  aiSource           String?
  passingScore       Float                  @default(70)
  shuffleQuestions   Boolean                @default(false)
  resultsPublishedAt DateTime?
  gradebookSyncedAt  DateTime?
  publishedAt        DateTime               @default(now())
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  course             Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions        AssignmentSubmission[]
  questions          AssignmentQuestion[]
}

model AssignmentQuestion {
  id            String                       @id @default(cuid())
  assignmentId  String
  questionText  String
  questionType  DiagnosticQuestionType
  options       Json?
  correctAnswer Json?
  points        Float                        @default(1)
  difficulty    DiagnosticDifficulty         @default(MEDIUM)
  competencyTag String
  explanation   String?
  order         Int                          @default(0)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  assignment    Assignment                   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  answers       AssignmentSubmissionAnswer[]

  @@index([assignmentId, order])
}

model TeacherActivityReport {
  id            String              @id @default(cuid())
  teacherId     String
  periodStart   DateTime
  periodEnd     DateTime
  title         String
  content       String              @db.Text
  evidence      Json
  aiSource      String
  recipientRole String
  status        TeacherReportStatus @default(DRAFT)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewerNote  String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  teacher       TeacherProfile      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, periodStart, periodEnd])
  @@index([status, submittedAt])
}

model AssignmentSubmission {
  id           String                       @id @default(cuid())
  assignmentId String
  studentId    String
  submittedAt  DateTime?
  startedAt    DateTime?
  score        Float?
  autoScore    Float?
  percentage   Float?
  feedback     String?
  aiFeedback   String?
  answersJson  Json?
  gradedAt     DateTime?
  status       SubmissionStatus             @default(PENDING)
  assignment   Assignment                   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      StudentProfile               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers      AssignmentSubmissionAnswer[]

  @@unique([assignmentId, studentId])
}

model Grade {
  id           String         @id @default(cuid())
  studentId    String
  courseId     String
  assignmentId String?
  score        Float
  maxScore     Float
  percentage   Float
  letterGrade  String
  period       String
  createdAt    DateTime       @default(now())
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentId, period, createdAt])
}

model NewsPost {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  excerpt     String
  content     String
  category    NewsCategory
  coverImage  String?
  tags        String[]
  publishedAt DateTime     @default(now())
  views       Int          @default(0)
  authorId    String
  author      User         @relation("NewsAuthor", fields: [authorId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Event {
  id                   String    @id @default(cuid())
  title                String
  description          String
  startDate            DateTime
  endDate              DateTime
  location             String
  type                 EventType
  coverImage           String?
  registrationRequired Boolean   @default(false)
  maxAttendees         Int?
  liveStreamEnabled    Boolean   @default(false)
  liveStreamUrl        String?
  liveStreamPlatform   String?
  liveStreamStatus     String    @default("scheduled")
  liveStreamStartsAt   DateTime?
  replayUrl            String?
  audienceRoles        UserRole[] @default([ADMIN, STAFF, TEACHER, STUDENT, PARENT])
  audienceGrades       String[]   @default([])
  reminderEnabled      Boolean    @default(true)
  reminderDaysBefore   Int        @default(7)
  reminderChannels     String[]   @default(["IN_APP", "EMAIL", "SMS"])
  reminderRevision     Int        @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  reminderDeliveries   EventReminderDelivery[]
}

model EventReminderDelivery {
  id             String   @id @default(cuid())
  eventId        String
  userId         String
  revision       Int
  inAppSentAt    DateTime?
  emailQueuedAt  DateTime?
  smsAttemptedAt DateTime?
  smsSentAt      DateTime?
  emailFailure   String?
  smsFailure     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, revision])
  @@index([eventId, revision])
  @@index([userId, createdAt])
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  studentId    String
  recordedById String?
  date         DateTime
  className    String
  period       String?
  subject      String?
  status       AttendanceStatus
  note         String?
  notifiedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy   User?            @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, date, className, period])
  @@index([date])
  @@index([status])
}

model StaffAttendanceRecord {
  id             String           @id @default(cuid())
  staffOrbitId   String
  employeeNumber String?
  staffName      String
  staffEmail     String?
  department     String?
  date           DateTime
  status         AttendanceStatus
  arrivalTime    String?
  departureTime  String?
  note           String?
  recordedById   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  recordedBy     User?            @relation("StaffAttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([staffOrbitId, date])
  @@index([date])
  @@index([staffEmail])
  @@index([status])
}

model MessageAttachment {
  id        String            @id @default(cuid())
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime          @default(now())
  messages  InternalMessage[]
}

model InternalMessage {
  id                  String                @id @default(cuid())
  senderId            String?
  recipientId         String?
  subject             String
  body                String
  attachmentName      String?
  attachmentMime      String?
  attachmentSize      Int?
  attachmentData      Bytes?
  sharedAttachmentId  String?
  sharedAttachment    MessageAttachment?    @relation(fields: [sharedAttachmentId], references: [id], onDelete: SetNull)
  targetRole          UserRole?
  readAt              DateTime?
  priority            String                @default("normal")
  channel             CorrespondenceChannel @default(PORTAL)
  createdAt           DateTime              @default(now())
  senderArchivedAt    DateTime?
  recipientArchivedAt DateTime?
  sender              User?                 @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient           User?                 @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([targetRole])
  @@index([createdAt])
  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@index([targetRole, createdAt])
  @@index([createdAt, id])
  @@index([sharedAttachmentId])
