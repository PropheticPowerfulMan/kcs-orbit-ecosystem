generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([usedAt])
  @@index([userId, expiresAt])
}

enum ImportJobStatus {
  UPLOADED
  MAPPED
  VALIDATED
  READY
  IMPORTING
  COMPLETED
  PARTIAL
  FAILED
  ROLLED_BACK
  ROLLBACK_PARTIAL
  ROLLBACK_BLOCKED
}

model ImportJob {
  id String @id @default(cuid())
  actorId String
  organizationId String?
  sourceSystem String @default("GENERIC")
  entityType String
  originalFileName String
  fileHash String
  status ImportJobStatus @default(UPLOADED)
  mapping Json?
  report Json?
  totalRows Int @default(0)
  createdRows Int @default(0)
  updatedRows Int @default(0)
  skippedRows Int @default(0)
  failedRows Int @default(0)
  mergedRows Int @default(0)
  invitationsSent Boolean @default(false)
  confirmedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([actorId, createdAt])
  @@index([organizationId, createdAt])
  @@index([status])
}

model ImportMappingTemplate {
  id String @id @default(cuid())
  name String
  actorId String
  organizationId String?
  sourceSystem String @default("GENERIC")
  entityType String
  sourceColumns String[]
  mapping Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId, name, entityType])
  @@index([organizationId, entityType])
}


model ImportChange {
  id String @id @default(cuid())
  importJobId String
  entityType String
  entityId String
  operation String
  oldValue Json?
  newValue Json?
  changedAt DateTime @default(now())
  rolledBackAt DateTime?
  rollbackError String?
  @@index([importJobId, changedAt])
  @@index([entityType, entityId])
}

enum UserRole {
  ADMIN
  STAFF
  TEACHER
  STUDENT
  PARENT
}

enum NewsCategory {
  NEWS
  EVENT
  ANNOUNCEMENT
  ACHIEVEMENT
  SPORTS
  ARTS
}

enum EventType {
  ACADEMIC
  SPIRITUAL
  SPORTS
  CULTURAL
  ADMINISTRATIVE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  ACCEPTED
  WAITLISTED
  REJECTED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  MESSAGE
}

enum AssignmentType {
  HOMEWORK
  QUIZ
  EXAM
  PROJECT
  LAB
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  SICK
  SUSPENDED
}

enum FeeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
}

enum DiagnosticSubject {
  FRENCH
  MATHEMATICS
}

enum DiagnosticTestStatus {
  DRAFT
  PUBLISHED
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  AUTO_GRADED
  PENDING_SUPER_ADMIN_APPROVAL
  APPROVED
  REJECTED
  RETAKE_REQUESTED
  ARCHIVED
}

enum DiagnosticQuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  NUMERIC
  ESSAY_OPTIONAL
}

enum DiagnosticDifficulty {
  EASY
  MEDIUM
  HARD
}

enum DiagnosticDecision {
  ACCEPT_REQUESTED_GRADE
  ACCEPT_WITH_REMEDIATION
  RECOMMEND_LOWER_LEVEL
  RETAKE_TEST
  ACADEMIC_INTERVIEW_REQUIRED
  REJECT
}

enum TeacherStatus {
  HOMEROOM_TEACHER
  TEACHER
  ASSISTANT_TEACHER
}

enum AdmissionInquiryStatus {
  NEW
  CONTACTED
  TOUR_SCHEDULED
  APPLICATION_INVITED
  CLOSED
}

enum FeeChargeKind {
  STANDARD_FEE
  DISCOUNT
  SCHOLARSHIP
  FAMILY_PAYMENT
  ADJUSTMENT
}

enum ReportPublicationStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  EMAILED
  POSTED_TO_PORTAL
}

enum CorrespondenceChannel {
  EMAIL
  TEXT
  LETTER
  CALL
  PORTAL
}

enum CorrespondenceStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  FAILED
  LOGGED
}

enum DisciplineSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DisciplineResolutionStatus {
  OPEN
  INVESTIGATING
  PARENT_CONTACTED
  RESOLVED
  ESCALATED
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  accessCode             String                 @unique
  passwordHash           String?
  firstName              String
  middleName             String?
  lastName               String
  role                   UserRole
  staffFunction          String?
  permissions            String[]               @default([])
  avatar                 String?
  phone                  String?
  googleId               String?                @unique
  orbitUserId            String?                @unique
  orbitOrganizationId    String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  studentProfile         StudentProfile?
  teacherProfile         TeacherProfile?
  parentLinks            ParentStudentLink[]    @relation("ParentLinks")
  notifications          Notification[]
  authoredNews           NewsPost[]             @relation("NewsAuthor")
  contactMessages        ContactMessage[]
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  forumPosts             ParentForumPost[]      @relation("ForumPostAuthor")
  forumComments          ParentForumComment[]   @relation("ForumCommentAuthor")
  aiForumReports         AIForumReport[]        @relation("AIForumReportReviewer")
  studentForumPosts      StudentForumPost[]     @relation("StudentForumPostAuthor")
  studentForumComments   StudentForumComment[]  @relation("StudentForumCommentAuthor")
  aiStudentForumReports  AIStudentForumReport[] @relation("AIStudentForumReportReviewer")
  auditLogs              AuditLog[]             @relation("AuditActor")
  staffProfile           StaffProfile?
  attendanceRecorded     AttendanceRecord[]     @relation("AttendanceRecorder")
  sentMessages           InternalMessage[]      @relation("MessageSender")
  receivedMessages       InternalMessage[]      @relation("MessageRecipient")
  approvedReportCards    ReportCard[]           @relation("ReportCardApprover")
  teacherWorkspace       TeacherWorkspace?
  suggestions            Suggestion[]           @relation("SuggestionAuthor")
  diagnosticTestsCreated DiagnosticTest[]       @relation("DiagnosticTestCreator")
  diagnosticApprovals    DiagnosticApproval[]   @relation("DiagnosticApprovalActor")
  teacherReviewsGiven    TeacherReview[]        @relation("TeacherReviewReviewer")
  correspondenceSent     CorrespondenceLog[]    @relation("CorrespondenceSender")
  disciplineReported     DisciplineCase[]       @relation("DisciplineReporter")
  disciplineResolved     DisciplineCase[]       @relation("DisciplineResolver")
  twoFactorEnabled       Boolean                @default(false)
  twoFactorSecret        String?
  twoFactorVerifiedAt    DateTime?
}

model TeacherWorkspace {
  id        String   @id @default(cuid())
  userId    String   @unique
  state     Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Suggestion {
  id            String   @id @default(cuid())
  authorId      String
  anonymousRole UserRole
  category      String
  message       String
  status        String   @default("New")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  author        User     @relation("SuggestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([status])
}

model StaffProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  employeeNumber String   @unique
  function       String
  department     String
  permissions    String[] @default([])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentProfile {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  studentNumber         String                 @unique
  grade                 String
  section               String
  dateOfBirth           DateTime?
  enrollmentDate        DateTime               @default(now())
  status                String                 @default("active")
  gpa                   Float?
  attendanceRate        Float?
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentLinks           ParentStudentLink[]    @relation("StudentLinks")
  enrollments           Enrollment[]
  grades                Grade[]
  submissions           AssignmentSubmission[]
  aiSessions            AITutorSession[]
  aiRecommendations     AIRecommendation[]
  attendanceRecords     AttendanceRecord[]
  reportCards           ReportCard[]
  transcripts           Transcript[]
  feeInvoices           FeeInvoice[]
  diagnosticAssignments DiagnosticAssignment[]
  diagnosticSubmissions DiagnosticSubmission[]
  disciplineCases       DisciplineCase[]
}

model ParentStudentLink {
  id        String         @id @default(cuid())
  parentId  String
  studentId String
  relation  String
  parent    User           @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model TeacherProfile {
  id                String           @id @default(cuid())
  userId            String           @unique
  employeeNumber    String           @unique
  department        String
  qualification     String
  yearsOfExperience Int
  bio               String?
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses           Course[]
  status            TeacherStatus    @default(TEACHER)
  homeroomGrade     String?
  homeroomSection   String?
  diagnosticTests   DiagnosticTest[]
  reviews           TeacherReview[]
}

model Course {
  id          String           @id @default(cuid())
  name        String
  code        String           @unique
  description String
  grade       String
  teacherId   String
  credits     Int              @default(1)
  syllabus    String?
  teacher     TeacherProfile   @relation(fields: [teacherId], references: [id])
  schedules   CourseSchedule[]
  assignments Assignment[]
  grades      Grade[]
  enrollments Enrollment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model CourseSchedule {
  id        String @id @default(cuid())
  courseId  String
  day       String
  startTime String
  endTime   String
  room      String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String         @id @default(cuid())
  courseId  String
  studentId String
  createdAt DateTime       @default(now())
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
}

model Assignment {
  id          String                 @id @default(cuid())
  courseId    String
  title       String
  description String
  dueDate     DateTime
  maxScore    Float
  type        AssignmentType
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  submittedAt  DateTime?
  score        Float?
  feedback     String?
  status       SubmissionStatus @default(PENDING)
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Grade {
  id           String         @id @default(cuid())
  studentId    String
  courseId     String
  assignmentId String?
  score        Float
  maxScore     Float
  percentage   Float
  letterGrade  String
  period       String
  createdAt    DateTime       @default(now())
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model NewsPost {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  excerpt     String
  content     String
  category    NewsCategory
  coverImage  String?
  tags        String[]
  publishedAt DateTime     @default(now())
  views       Int          @default(0)
  authorId    String
  author      User         @relation("NewsAuthor", fields: [authorId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Event {
  id                   String    @id @default(cuid())
  title                String
  description          String
  startDate            DateTime
  endDate              DateTime
  location             String
  type                 EventType
  coverImage           String?
  registrationRequired Boolean   @default(false)
  maxAttendees         Int?
  liveStreamEnabled    Boolean   @default(false)
  liveStreamUrl        String?
  liveStreamPlatform   String?
  liveStreamStatus     String    @default("scheduled")
  liveStreamStartsAt   DateTime?
  replayUrl            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  studentId    String
  recordedById String?
  date         DateTime
  className    String
  period       String?
  subject      String?
  status       AttendanceStatus
  note         String?
  notifiedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy   User?            @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, date, className, period])
  @@index([date])
  @@index([status])
}

model InternalMessage {
  id          String                @id @default(cuid())
  senderId    String?
  recipientId String?
  subject     String
  body        String
  targetRole  UserRole?
  readAt      DateTime?
  priority    String                @default("normal")
  channel     CorrespondenceChannel @default(PORTAL)
  createdAt   DateTime              @default(now())
  sender      User?                 @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient   User?                 @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([targetRole])
  @@index([createdAt])
}

model ReportCard {
  id                 String                  @id @default(cuid())
  studentId          String
  term               String
  average            Float
  conduct            String?
  teacherComment     String?
  principalStatus    String                  @default("DRAFT")
  approvedById       String?
  approvedAt         DateTime?
  pdfUrl             String?
  paymentCondition   String                  @default("PENDING_REVIEW")
  feeSummary         Json?
  publicationStatus  ReportPublicationStatus @default(DRAFT)
  emailedAt          DateTime?
  portalPostedAt     DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  student            StudentProfile          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approvedBy         User?                   @relation("ReportCardApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  correspondenceLogs CorrespondenceLog[]

  @@unique([studentId, term])
}

model Transcript {
  id            String         @id @default(cuid())
  studentId     String
  academicYears String
  credits       Float
  cumulativeGpa Float
  status        String         @default("IN_PROGRESS")
  pdfUrl        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model FeeInvoice {
  id        String         @id @default(cuid())
  studentId String
  invoiceNo String         @unique
  amount    Float
  balance   Float
  status    FeeStatus      @default(PENDING)
  dueDate   DateTime
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments  FeePayment[]
  charges   FeeCharge[]
}

model FeePayment {
  id         String     @id @default(cuid())
  invoiceId  String
  amount     Float
  method     String
  reference  String?
  paidAt     DateTime   @default(now())
  receiptUrl String?
  invoice    FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model AdmissionApplication {
  id                    String                        @id @default(cuid())
  applicationNumber     String                        @unique
  firstName             String
  middleName            String?
  lastName              String
  dateOfBirth           DateTime
  gender                String
  nationality           String
  gradeApplying         String
  previousSchool        String?
  parentName            String
  parentEmail           String
  parentPhone           String
  relationship          String
  address               String
  notes                 String?
  status                ApplicationStatus             @default(SUBMITTED)
  submittedAt           DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  documents             AdmissionDocument[]
  diagnosticAssignments DiagnosticAssignment[]
  diagnosticSubmissions DiagnosticSubmission[]
  diagnosticAnalytics   DiagnosticAnalyticsSnapshot[]
}

model AdmissionDocument {
  id            String               @id @default(cuid())
  applicationId String
  name          String
  type          String
  url           String
  uploadedAt    DateTime             @default(now())
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model MediaItem {
  id           String    @id @default(cuid())
  title        String
  description  String?
  url          String
  thumbnailUrl String?
  type         MediaType
  category     String
  tags         String[]
  uploadedAt   DateTime  @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AITutorSession {
  id        String           @id @default(cuid())
  studentId String
  subject   String
  topic     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages  AITutorMessage[]
}

model AITutorMessage {
  id        String         @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime       @default(now())
  session   AITutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AIRecommendation {
  id          String         @id @default(cuid())
  studentId   String
  title       String
  description String
  riskLevel   String
  createdAt   DateTime       @default(now())
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ParentForumPost {
  id        String               @id @default(cuid())
  authorId  String
  title     String
  content   String
  category  String
  status    String               @default("open")
  sentiment String               @default("neutral")
  priority  String               @default("normal")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  author    User                 @relation("ForumPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments  ParentForumComment[]

  @@index([category])
  @@index([createdAt])
}

model ParentForumComment {
  id        String          @id @default(cuid())
  postId    String
  authorId  String
  content   String
  sentiment String          @default("neutral")
  createdAt DateTime        @default(now())
  post      ParentForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User            @relation("ForumCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model AIForumReport {
  id              String    @id @default(cuid())
  title           String
  summary         String
  sentiment       String
  riskLevel       String
  keyTopics       String[]
  recommendations String[]
  actionItems     String[]
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  reviewedBy      User?     @relation("AIForumReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
}

model StudentForumPost {
  id             String                @id @default(cuid())
  authorId       String
  title          String
  content        String
  category       String
  status         String                @default("open")
  sentiment      String                @default("neutral")
  priority       String                @default("normal")
  attachmentType String?
  attachmentData String?
  attachmentName String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  author         User                  @relation("StudentForumPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments       StudentForumComment[]

  @@index([category])
  @@index([createdAt])
}

model StudentForumComment {
  id        String           @id @default(cuid())
  postId    String
  authorId  String
  content   String
  sentiment String           @default("neutral")
  createdAt DateTime         @default(now())
  post      StudentForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User             @relation("StudentForumCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model AIStudentForumReport {
  id              String    @id @default(cuid())
  title           String
  summary         String
  sentiment       String
  riskLevel       String
  keyTopics       String[]
  recommendations String[]
  actionItems     String[]
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  reviewedBy      User?     @relation("AIStudentForumReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
}

model DiagnosticTest {
  id                 String                 @id @default(cuid())
  title              String
  subject            DiagnosticSubject
  gradeLevel         String
  academicYear       String
  createdByTeacherId String?
  createdByUserId    String?
  status             DiagnosticTestStatus   @default(DRAFT)
  durationMinutes    Int?
  passingScore       Float                  @default(70)
  competencies       String[]               @default([])
  answerKey          Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  createdByTeacher   TeacherProfile?        @relation(fields: [createdByTeacherId], references: [id], onDelete: SetNull)
  createdByUser      User?                  @relation("DiagnosticTestCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  questions          DiagnosticQuestion[]
  assignments        DiagnosticAssignment[]
  submissions        DiagnosticSubmission[]

  @@index([subject, gradeLevel, status])
  @@index([academicYear])
}

model DiagnosticQuestion {
  id            String                 @id @default(cuid())
  testId        String
  questionText  String
  questionType  DiagnosticQuestionType
  options       Json?
  correctAnswer Json?
  points        Float                  @default(1)
  difficulty    DiagnosticDifficulty   @default(MEDIUM)
  competencyTag String
  explanation   String?
  order         Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  test          DiagnosticTest         @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers       DiagnosticAnswer[]

  @@index([testId, order])
}

model DiagnosticAssignment {
  id                      String                @id @default(cuid())
  testId                  String
  studentId               String?
  enrollmentApplicationId String?
  applicantName           String?
  applicantEmail          String?
  status                  DiagnosticTestStatus  @default(ASSIGNED)
  assignedById            String?
  assignedAt              DateTime              @default(now())
  dueAt                   DateTime?
  test                    DiagnosticTest        @relation(fields: [testId], references: [id], onDelete: Cascade)
  student                 StudentProfile?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  enrollmentApplication   AdmissionApplication? @relation(fields: [enrollmentApplicationId], references: [id], onDelete: SetNull)
  submission              DiagnosticSubmission?

  @@index([status, assignedAt])
  @@index([studentId])
  @@index([enrollmentApplicationId])
}

model DiagnosticSubmission {
  id                      String                        @id @default(cuid())
  testId                  String
  assignmentId            String?                       @unique
  studentId               String?
  enrollmentApplicationId String?
  applicantName           String?
  answersJson             Json?
  startedAt               DateTime                      @default(now())
  submittedAt             DateTime?
  autoScore               Float                         @default(0)
  percentage              Float                         @default(0)
  status                  DiagnosticTestStatus          @default(IN_PROGRESS)
  statistics              Json?
  aiRecommendation        Json?
  teacherReview           String?
  superAdminDecision      DiagnosticDecision?
  finalComment            String?
  approvedById            String?
  approvedAt              DateTime?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  test                    DiagnosticTest                @relation(fields: [testId], references: [id], onDelete: Cascade)
  assignment              DiagnosticAssignment?         @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  student                 StudentProfile?               @relation(fields: [studentId], references: [id], onDelete: SetNull)
  enrollmentApplication   AdmissionApplication?         @relation(fields: [enrollmentApplicationId], references: [id], onDelete: SetNull)
  answers                 DiagnosticAnswer[]
  analyticsSnapshots      DiagnosticAnalyticsSnapshot[]
  approvals               DiagnosticApproval[]

  @@index([status, submittedAt])
  @@index([studentId])
  @@index([enrollmentApplicationId])
}

model DiagnosticAnswer {
  id            String               @id @default(cuid())
  submissionId  String
  questionId    String
  answer        Json?
  isCorrect     Boolean?
  pointsAwarded Float                @default(0)
  feedback      String?
  createdAt     DateTime             @default(now())
  submission    DiagnosticSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question      DiagnosticQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
}

model DiagnosticAnalyticsSnapshot {
  id                      String                @id @default(cuid())
  submissionId            String
  enrollmentApplicationId String?
  summaryJson             Json
  generatedAt             DateTime              @default(now())
  submission              DiagnosticSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  enrollmentApplication   AdmissionApplication? @relation(fields: [enrollmentApplicationId], references: [id], onDelete: SetNull)

  @@index([generatedAt])
  @@index([enrollmentApplicationId])
}

model DiagnosticApproval {
  id           String               @id @default(cuid())
  submissionId String
  actorId      String?
  action       DiagnosticTestStatus
  decision     DiagnosticDecision?
  comment      String?
  createdAt    DateTime             @default(now())
  submission   DiagnosticSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor        User?                @relation("DiagnosticApprovalActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([submissionId, createdAt])
}

model TeacherReview {
  id         String         @id @default(cuid())
  teacherId  String
  reviewerId String?
  rating     Int
  summary    String
  goals      String?
  reviewedAt DateTime       @default(now())
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  reviewer   User?          @relation("TeacherReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@index([reviewedAt])
}

model FeeCharge {
  id        String        @id @default(cuid())
  invoiceId String
  kind      FeeChargeKind
  label     String
  amount    Float
  notes     String?
  createdAt DateTime      @default(now())
  invoice   FeeInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([kind])
}

model AdmissionInquiry {
  id                     String                 @id @default(cuid())
  inquiryNumber          String                 @unique
  parentName             String
  parentEmail            String
  parentPhone            String?
  studentName            String?
  gradeInterest          String
  source                 String?
  message                String?
  status                 AdmissionInquiryStatus @default(NEW)
  nextFollowUpAt         DateTime?
  convertedApplicationId String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([status])
  @@index([createdAt])
}

model DisciplineCase {
  id                 String                     @id @default(cuid())
  studentId          String
  reportedById       String?
  resolvedById       String?
  incidentDate       DateTime                   @default(now())
  category           String
  severity           DisciplineSeverity         @default(MEDIUM)
  gradeImpact        String?
  incident           String
  resolution         String?
  actionTaken        String?
  parentNotifiedAt   DateTime?
  studentNotifiedAt  DateTime?
  status             DisciplineResolutionStatus @default(OPEN)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  student            StudentProfile             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reportedBy         User?                      @relation("DisciplineReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  resolvedBy         User?                      @relation("DisciplineResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  correspondenceLogs CorrespondenceLog[]

  @@index([studentId])
  @@index([status])
  @@index([severity])
  @@index([incidentDate])
}

model CorrespondenceLog {
  id               String                @id @default(cuid())
  channel          CorrespondenceChannel
  status           CorrespondenceStatus  @default(LOGGED)
  subject          String
  body             String
  senderId         String?
  recipientName    String?
  recipientEmail   String?
  recipientPhone   String?
  studentId        String?
  reportCardId     String?
  disciplineCaseId String?
  sentAt           DateTime?
  deliveredAt      DateTime?
  failureReason    String?
  metadata         Json?
  createdAt        DateTime              @default(now())
  sender           User?                 @relation("CorrespondenceSender", fields: [senderId], references: [id], onDelete: SetNull)
  reportCard       ReportCard?           @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  disciplineCase   DisciplineCase?       @relation(fields: [disciplineCaseId], references: [id], onDelete: Cascade)

  @@index([channel])
  @@index([status])
  @@index([createdAt])
  @@index([reportCardId])
  @@index([disciplineCaseId])
}


enum IncidentReportStatus {
  SUBMITTED
  UNDER_REVIEW
  CLOSED
}
enum IncidentConfidentiality {
  STANDARD
  CONFIDENTIAL
}
model IncidentReport {
  id String @id @default(cuid())
  reference String @unique
  title String
  category String
  occurredAt DateTime
  location String
  description String
  peopleInvolved String?
  immediateActions String?
  confidentiality IncidentConfidentiality @default(STANDARD)
  status IncidentReportStatus @default(SUBMITTED)
  adminNotes String?
  authorId String
  authorRole UserRole
  authorName String
  attachmentName String?
  attachmentMime String?
  attachmentSize Int?
  attachmentData Bytes?
  verificationHash String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([authorId, createdAt])
  @@index([status, createdAt])
}
